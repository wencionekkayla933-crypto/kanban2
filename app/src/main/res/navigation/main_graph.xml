<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.kayla.kanban.ui.SplashFragment"
        android:label="SplashFragment">

        <action
            android:id="@+id/action_splashFragment_to_authentication"
            app:destination="@id/authentication"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <navigation
        android:id="@+id/authentication"
        app:startDestination="@id/loginFragment">

        <action
            android:id="@+id/action_authentication_to_homeFragment"
            app:destination="@id/homeFragment" />

        <fragment
            android:id="@+id/loginFragment"
            android:name="com.kayla.kanban.ui.auth.LoginFragment"
            android:label="LoginFragment">

            <action
                android:id="@+id/action_loginFragment_to_registerFragment"
                app:destination="@id/registerFragment" />

            <action
                android:id="@+id/action_loginFragment_to_recoverAccountFragment"
                app:destination="@id/recoverAccountFragment" />

        </fragment>

        <fragment
            android:id="@+id/registerFragment"
            android:name="com.kayla.kanban.ui.auth.RegisterFragment"
            android:label="RegisterFragment" />

        <fragment
            android:id="@+id/recoverAccountFragment"
            android:name="com.kayla.kanban.ui.auth.RecoverAccountFragment"
            android:label="RecoverAccountFragment" />

    </navigation>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.kayla.kanban.ui.HomeFragment"
        android:label="HomeFragment" />

</navigation>